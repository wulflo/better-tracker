{
  "$schema": "https://schema.tauri.app/v2/config",
  "productName": "Better Tracker",
  "version": "0.9.3",
  "identifier": "com.bettertracker.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "Better Tracker",
        "width": 420,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": true,
        "url": "splash.html"
      },
      {
        "label": "main",
        "title": "Better Tracker",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/wulflo/better-tracker/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzNzg0OTE2MEI1MUVCNDYKUldSRzYxRUxGa2w0QTZmQnJLVkJ2M3RpMlRtN2hDUU1HbGZ5c2o2WDhnTVhBV2d6Y3NOeGdrMW8K"
    }
  }
}
