{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://better-tracker.dev/schemas/release-manifest.schema.json",
  "title": "ReleaseManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "commit", "date", "vault_schema_version", "assets"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "commit": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "minLength": 1
    },
    "vault_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "platform", "arch", "format", "sha256", "size"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "platform": { "type": "string", "minLength": 1 },
          "arch": { "type": "string", "minLength": 1 },
          "format": { "type": "string", "minLength": 1 },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}